# ============================================================
# Configuration du bot Telegram Gold Fundamental Analysis
# Copier ce fichier en `.env` puis remplir les valeurs.
# ============================================================

# --- TELEGRAM ---
# Token obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# ID du chat Telegram dédié (peut être un user_id, un group_id ou channel_id).
# Tip : démarrer le bot, lui écrire /id, il vous renvoie l'ID à coller ici.
TELEGRAM_CHAT_ID=

# Liste d'IDs autorisés à utiliser /now (séparés par virgule).
# Laisser vide = uniquement TELEGRAM_CHAT_ID est autorisé.
TELEGRAM_ALLOWED_USERS=

# --- SCHEDULER ---
# Heure d'envoi quotidien (24h, format HH:MM) dans le fuseau ci-dessous
DAILY_RUN_TIME=06:00
TIMEZONE=Europe/Paris

# --- SOURCES (clés API optionnelles) ---
# FRED API : https://fred.stlouisfed.org/docs/api/api_key.html (gratuit)
FRED_API_KEY=

# X/Twitter API v2 Bearer Token (payant - optionnel)
# Si vide, les sources Tier S / Tier A Twitter seront ignorées
X_BEARER_TOKEN=

# --- LOG LEVEL ---
LOG_LEVEL=INFO
