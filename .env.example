# ============================================================
# Configuration du bot Telegram Gold Fundamental Analysis
# Copier ce fichier en `.env` puis remplir les valeurs.
# ============================================================

# --- TELEGRAM ---
# Token obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID PRINCIPAL (toi, le owner). Reçoit les messages système.
# Tip : démarrer le bot, lui écrire /id, il vous renvoie l'ID à coller ici.
TELEGRAM_CHAT_ID=

# Votre user_id Telegram (admin du bot). Auto-ajouté comme subscriber + admin.
# Récupéré via /id dans le chat avec le bot.
OWNER_USER_ID=

# Code d'invitation pour autoriser des amis. Vide = subscription ouverte.
# Vos amis utiliseront : /subscribe MONCODE
INVITE_CODE=

# --- SCHEDULER ---
# Heure d'envoi quotidien (24h, format HH:MM) dans le fuseau ci-dessous
DAILY_RUN_TIME=06:00
TIMEZONE=Europe/Paris

# --- ALERTES MACRO INTRA-DAY ---
# Active la surveillance des nouvelles publications CPI / NFP / PCE
ALERTS_ENABLED=true
# Heure de check des publications BLS (8:30 EST = 14:30 Paris)
ALERTS_CHECK_TIME=14:35

# --- TRADINGVIEW WEBHOOK ---
# Active le serveur HTTP pour recevoir les alertes TradingView
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8080
# Secret à inclure dans le payload TradingView (champ "secret")
WEBHOOK_SECRET=

# --- SOURCES (clés API optionnelles) ---
# FRED API : https://fred.stlouisfed.org/docs/api/api_key.html (gratuit)
FRED_API_KEY=

# Compte Truth Social à monitorer (par défaut : Trump)
TRUTH_SOCIAL_ACCOUNT_ID=107780257626128497

# --- LOG LEVEL ---
LOG_LEVEL=INFO
